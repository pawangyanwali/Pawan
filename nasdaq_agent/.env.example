# ── NASDAQ Scalping Agent — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in all REQUIRED values.
# Never commit .env to version control.
#
# ARCHITECTURE NOTE
# -----------------
# Runtime-tunable parameters (risk limits, trade sizing, scanner cadence, etc.)
# are stored in PostgreSQL `config_store` and hot-reloaded via Valkey pub/sub.
# They do NOT belong in this file.  Use the dashboard  /api/config  endpoint
# to read or change them at runtime without restarting any container.
#
# This file contains only:
#   SECTION 1 — Secrets & bootstrap (must be in .env, never in the database)
#   SECTION 2 — Deployment infrastructure (ports, CORS, image tag)
#   SECTION 3 — Optional first-deploy seeds (override PG config_store defaults)
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 1 — Secrets & Bootstrap  (REQUIRED — never stored in the database)
# ═══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL (AWS RDS) ──────────────────────────────────────────────────────
PGHOST=your-rds-instance.region.rds.amazonaws.com   # REQUIRED
PGPORT=5432
PGDATABASE=nasdaq_agent
PGUSER=nasdaq                                        # REQUIRED
PGPASSWORD=change-me                                 # REQUIRED
PGSSLMODE=require

# ── ElastiCache / Valkey ──────────────────────────────────────────────────────
VALKEY_HOST=master.your-cluster.region.cache.amazonaws.com  # REQUIRED
VALKEY_PORT=6379
VALKEY_SSL=true

# ── Schwab API — OAuth credentials ────────────────────────────────────────────
# Trading + accounts app (created in the Schwab developer portal)
SCHWAB_CLIENT_ID=                                    # REQUIRED
SCHWAB_CLIENT_SECRET=                                # REQUIRED
SCHWAB_ACCOUNT_NUMBER=                               # REQUIRED
# Full URL Docker Compose exposes — must match the redirect URI in your Schwab app.
SCHWAB_CALLBACK_URL=http://your-ec2-ip-or-domain:8000/schwab/callback/at

# ── Schwab Market Data — separate OAuth app ───────────────────────────────────
SCHWAB_MD_CLIENT_ID=                                 # REQUIRED
SCHWAB_MD_CLIENT_SECRET=                             # REQUIRED

# ── Finnhub (earnings calendar + news) ───────────────────────────────────────
FINNHUB_API_KEY=                                     # REQUIRED

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-real-secret          # REQUIRED
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 2 — Deployment Infrastructure  (set once per host, rarely changed)
# ═══════════════════════════════════════════════════════════════════════════════

APP_ENV=production
LOG_LEVEL=INFO

# ── Web API ───────────────────────────────────────────────────────────────────
WEB_API_PORT=8000
# Comma-separated allowed origins for CORS.
# Set to your EC2 public IP or domain: http://1.2.3.4:8000
CORS_ORIGINS=http://localhost:8000

# ── Scanner ───────────────────────────────────────────────────────────────────
# Number of parallel ML inference workers.  Set to (vCPU count - 1) max.
PIPELINE_WORKERS=8

# ── Learner startup ───────────────────────────────────────────────────────────
# One-time delay at container start so the scanner settles before the first
# BiLSTM training cycle.  Not a runtime knob — set it here, not in the DB.
LEARNER_DEEP_STARTUP_DELAY_S=300

# ── Other startup delays ──────────────────────────────────────────────────────
NASDAQ_MD_STARTUP_DELAY_S=10
SCHEDULER_HEARTBEAT_S=30
WATCHDOG_INTERVAL_S=30
WATCHDOG_UNHEALTHY_STRIKES=2
WATCHDOG_RESTART_TIMEOUT_S=10

# ── Docker image ──────────────────────────────────────────────────────────────
# Override to pin a specific tag for deployments.
IMAGE_TAG=latest


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 3 — Optional First-Deploy Seeds
#
# These values are written into PostgreSQL config_store on the FIRST deploy only
# (when the key is absent from the DB).  After that, the DB is the source of
# truth — changing these lines has NO effect on a running system.  Use the
# dashboard or  POST /api/config  to update them at runtime.
#
# Leave all of these commented out to accept the built-in defaults.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Paper trading ─────────────────────────────────────────────────────────────
# PAPER_BUDGET=50000
# PAPER_MAX_TRADE_PCT=5.0
# PAPER_MAX_ALLOCATED_PCT=40.0
# PAPER_MAX_OPEN_TRADES=10
# PAPER_TRADE_MIN_CONFIDENCE=25.0

# ── Trading / account sizing ──────────────────────────────────────────────────
# TRADING_ACCOUNT_SIZE=50000
# TRADING_RISK_PCT=1.5
# TRADING_MAX_POSITION_PCT=10.0
# IS_PAPER_TRADING=true

# ── Broker flags ──────────────────────────────────────────────────────────────
# SCHWAB_AUTO_TRADE=false
# SCHWAB_PAPER_TRADING=true

# ── Scanner cadence ───────────────────────────────────────────────────────────
# SCAN_INTERVAL_SECONDS=60

# ── Risk controls ─────────────────────────────────────────────────────────────
# DAILY_LOSS_WARNING_PCT=1.5
# DAILY_LOSS_HALT_PCT=2.5
# DAILY_PROFIT_TARGET=1000
# DAILY_PROFIT_MAX=1500
# MAX_CONCURRENT_TRADES=3
# MAX_PORTFOLIO_HEAT_PCT=1.5
# MAX_CONSECUTIVE_LOSSES=5
# COOLDOWN_LOSSES=3
# MAX_DAILY_TRADES=30

# ── Profit protect mode ───────────────────────────────────────────────────────
# PROFIT_PROTECT_CONF=80.0
# PROFIT_PROTECT_SIZE=0.60
# PROFIT_PROTECT_DRAWDOWN=300

# ── Volatility / drawdown circuit breakers ────────────────────────────────────
# VOLATILITY_HALT_ATR_MULT=2.5
# DRAWDOWN_THROTTLE_1_PCT=0.5
# DRAWDOWN_THROTTLE_2_PCT=1.0

# ── Learner runtime knobs ─────────────────────────────────────────────────────
# LEARNER_DEEP_ENABLED=1
# LEARNER_DEEP_INTERVAL_S=3600
# LEARNER_DEEP_TICKER_LIMIT=100
