# ── NASDAQ Scalping Agent — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in all values marked REQUIRED.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (AWS RDS) ──────────────────────────────────────────────────────
PGHOST=your-rds-instance.region.rds.amazonaws.com   # REQUIRED
PGPORT=5432
PGDATABASE=nasdaq_agent
PGUSER=nasdaq                                        # REQUIRED
PGPASSWORD=change-me                                 # REQUIRED
PGSSLMODE=require

# ── ElastiCache / Valkey ──────────────────────────────────────────────────────
VALKEY_HOST=master.your-cluster.region.cache.amazonaws.com  # REQUIRED
VALKEY_PORT=6379
VALKEY_SSL=true

# ── Schwab API (Accounts + Trading OAuth) ─────────────────────────────────────
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_ACCOUNT_NUMBER=
SCHWAB_AUTO_TRADE=false
SCHWAB_PAPER_TRADING=true
# Full URL Docker Compose exposes — must match Schwab app redirect URI.
SCHWAB_CALLBACK_URL=http://your-ec2-ip-or-domain:8000/schwab/callback/at

# ── Schwab Market Data OAuth (separate app in Schwab developer portal) ────────
SCHWAB_MD_CLIENT_ID=
SCHWAB_MD_CLIENT_SECRET=

# ── Finnhub (earnings calendar + news) ───────────────────────────────────────
FINNHUB_API_KEY=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-real-secret         # REQUIRED
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7
APP_ENV=production

# ── Web API ───────────────────────────────────────────────────────────────────
WEB_API_PORT=8000
# Comma-separated allowed origins for CORS.
# Set to your EC2 public IP or domain: http://1.2.3.4:8000
CORS_ORIGINS=http://localhost:8000

# ── Trading Parameters ────────────────────────────────────────────────────────
IS_PAPER_TRADING=true
TRADING_ACCOUNT_SIZE=50000
TRADING_RISK_PCT=1.5
PAPER_BUDGET=50000
PAPER_MAX_OPEN_TRADES=10
MAX_CONCURRENT_TRADES=3
DAILY_LOSS_HALT_PCT=2.5

# ── Scanner ───────────────────────────────────────────────────────────────────
PIPELINE_WORKERS=8

# ── Learner ───────────────────────────────────────────────────────────────────
LEARNER_DEEP_ENABLED=1
LEARNER_DEEP_INTERVAL_S=3600
LEARNER_DEEP_STARTUP_DELAY_S=300
LEARNER_DEEP_TICKER_LIMIT=100

# ── Market Data ───────────────────────────────────────────────────────────────
NASDAQ_MD_STARTUP_DELAY_S=10

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULER_HEARTBEAT_S=30

# ── Watchdog ──────────────────────────────────────────────────────────────────
WATCHDOG_INTERVAL_S=30
WATCHDOG_UNHEALTHY_STRIKES=2
WATCHDOG_RESTART_TIMEOUT_S=10

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Docker image ──────────────────────────────────────────────────────────────
# Override to pin a specific image tag for deployments.
IMAGE_TAG=latest
